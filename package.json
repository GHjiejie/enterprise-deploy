{
  "name": "enterprise-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "configure": "tsx build/console-server.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run profiles:validate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "profiles:validate": "tsx build/validate-profiles.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:delivery": "playwright test",
    "test:console": "playwright test --config playwright.console.config.ts",
    "test:matrix": "tsx build/delivery-matrix.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run profiles:validate && npm test",
    "release:verify": "tsx build/release-cli.ts verify",
    "release:archive": "tsx build/release-cli.ts archive",
    "release:deploy": "tsx build/release-cli.ts deploy",
    "release:rollback": "tsx build/release-cli.ts rollback"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
