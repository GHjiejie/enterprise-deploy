{
  "name": "enterprise-modular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "configure": "tsx build/console/server.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsx build/enterprise.ts",
    "validate": "tsx build/validate.ts",
    "audit": "tsx build/audit.ts",
    "package": "tsx build/package.ts",
    "publish": "tsx build/publish.ts",
    "preview": "tsx build/preview.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:console": "playwright test --config playwright.console.config.ts",
    "test:external": "playwright test --config playwright.external.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run validate && npm test"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "22.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "postcss": "8.5.30",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.13"
  }
}
